  m_Script: {fileID: 11500000, guid: 8531e054beae49c45bd366b7b52c7ccd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _isBubbleSpeechUnique: 1
  _bubbleSpeech:
    _goodTableSpeech:
    - Wow trop bien ce bar
    - J'adore la vibe
    - La serveuse est super sympa
    - Je vais ramener des amis ici
    - "Oh je suis s\xFBr que Jul kifferai"
    _averageTableSpeech:
    - Dommage c'etait mieux avant
    - La table est bancale...
    - Y'a aucun ambiance
    - "Je me sens pas \xE0 l'aise"
    - "Y'a que moi qui suis mitig\xE9 ?"
    _goodLeavingSpeech:
    - A la prochaine !
    - "Vous me reverrez bient\xF4t !"
    - "A tr\xE8s vite"
    - "J'ai d\xE9j\xE0 h\xE2te de revenir"
    - A plus !
    _averageLeavingSpeech:
    - "Pas s\xFBr que je reviendrais"
    - "Y'a pas mal de trucs \xE0 changer"
    - Y'a du potentiel
    - Moue bof
    - "Je repasserai peut \xEAtre... ou pas"
    _badLeavingSpeech:
    - "Premi\xE8re et derni\xE8re fois ici"
    - "Pff d\xE9\xE7u"
    - "5\u20AC pour la pinte de pisse..."
    - A FUIIIIIIIIR
    - C'est ciao pour moi
