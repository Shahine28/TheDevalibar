  _bubbleSpeech:
    _goodTableSpeech:
    - 'Amy : Je sens mon pouvoir grandir !'
    - "Amy : Je dois m'entra\xEEner avec Sensei Gary ici !"
    - 'Amy : Watashi no shinpiteki gekkou no shita !'
    - "Amy : La pression spirituelle de la Barmaid est \xE9norme..."
    - 'Maya : Un bar avec de la bonne musique, c''est rare'
    - 'Maya : Amy va jamais s''ennuyer ici, c''est certain'
    - "Maya : Le vin est d\xE9licieux !"
    - 'Maya : C''est inspirant cpmme endroit'
    _averageTableSpeech:
    - 'Amy : Je sens pas de chakra ici...'
    - "Amy : Maman ! J'peux avoir ton baton magique piti\xE9 !"
    - "Amy : Huh, cette potion est trop am\xE8re"
    - "Amy : J'ai envie d'aller voir Tata Genevi\xE8ve, Maman !"
    - "Maya : Amy, tu veux partir quand ma ch\xE9rie ?"
    - 'Maya : Pas trop confort...'
    - "Maya : J'ai du mal \xE0 m'orienter, arf"
    - "Maya : Le lieu est \xE0 am\xE9liorer"
    _goodLeavingSpeech:
    - 'Amy : La justice n''attend pas !'
    - 'Amy : Au revoir Super Barmaid !'
    - 'Maya : On reviendra !'
    - 'Maya : Amy, rends moi ma canne !'
    _averageLeavingSpeech:
    - "Amy : Vite Maman ! L'\xE9pisode est sorti !"
    - 'Amy : Mamaaaaaan, on peut passer au magasin !?'
    - "Maya : D\xE9p\xE8ches Amy, le cours commence !"
    - "Maya : Au revoir, \xE0 demain peut-\xEAtre"
    _badLeavingSpeech:
    - 'Amy : Oh non, aucune place pour Maman...!'
    - "Amy : On part d\xE9j\xE0 ?!"
    - 'Maya : Allez Amy, on s''en va'
    - 'Maya : On repassera demain'
