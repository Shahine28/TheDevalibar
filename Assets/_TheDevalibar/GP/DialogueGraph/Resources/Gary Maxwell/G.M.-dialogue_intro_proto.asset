  DialogueNodeData:
  - NodeGUID: e9575ac2-efac-4702-aa91-49600134a2dd
    DialogueText: Bien le bonjour l'ami.
    Position: {x: 247.5, y: 201}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 1b84a277-ed98-4425-8c49-f72a43ff5fae
    DialogueText: "Sympa ton rade ! \xE7a me rappel les vieilles caves du 13\xE8me."
    Position: {x: 716, y: 200}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 4c52517d-2174-4dca-abab-4e2f65ed05cf
    DialogueText: "En plus accessible quand m\xEAme. Bien vu pour la rampe d'ailleurs
      !"
    Position: {x: 1352, y: 199.5}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: e1cb4546-25cf-4b08-9534-0e25e95f7657
    DialogueText: "\xE7a fait des ann\xE9es que je veux venir ici, mais l'ex-patron
      \xE9tait un connard."
    Position: {x: 2025.5, y: 200.5}
    StatModifier: 0
    Ports:
    - PortName: Haha, normal, c'est la moindre des choses
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    - PortName: Pourquoi ce bar en particulier ? Il est pas si ouf.
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: e38636f6-d2c5-45f3-82ec-5f16d53330b2
    DialogueText: Ouais, pas pour tout le monde.
    Position: {x: 2685.5, y: 40.5}
    StatModifier: 5
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 7c4176ae-ce5f-46c9-adda-802471870e6e
    DialogueText: "C'est vrai qu'il sent le renferm\xE9, mais c'\xE9tait le bar o\xF9
      mon vieux venait."
    Position: {x: 2701.5, y: 286}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 9fb6623b-117e-47f7-8709-2a13a87cf850
    DialogueText: Bon, donne moi 2 verres s'il te plait, j'vais prendre une place.
    Position: {x: 3201.5, y: 34.5}
    StatModifier: 0
    Ports:
    - PortName: 2 verres ? Putain t'as bien soif.
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    - PortName: Vas-y l'ancien, amuse toi bien.
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 9cf0a52e-6781-47e0-8238-551f6bf204f1
    DialogueText: "Ce vieux rat passait son temps ici, mais c'\xE9tait un bon bougre,
      qu'il repose en paix."
    Position: {x: 3350, y: 289}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 5f68734f-5bdd-4bef-b55f-510051cd46a2
    DialogueText: "Haha, non, le deuxi\xE8me c'est pour mon vieux, paix \xE0 son
      \xE2me."
    Position: {x: 3761.5, y: -150}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 2ccb66c5-27b5-499e-ba98-a4cec1f5f7aa
    DialogueText: "Il vennait ici quand j'\xE9tais petiot, mais j'ai jamais pu l'accompagner"
    Position: {x: 4380, y: -150.5}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: dbd68ce1-e2f4-4fa5-8166-a7ec254317ee
    DialogueText: "\xE0 cause de ce barman de merde. il \xE0 jamais voulu installer
      la moindre rampe, que dalle."
    Position: {x: 5024, y: -148.5}
    StatModifier: 0
    Ports:
    - PortName: Ouais, pas cool.
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    - PortName: "Ton p\xE8re venait souvent ici ?"
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 4ec8c817-00bd-4687-916a-6eaffb575b8a
    DialogueText: "Ouais, tous les soirs, il s'asseyait toujours \xE0 la m\xEAme
      table \xE0 l'\xE9tage, \xE0 droite."
    Position: {x: 5765.5, y: -17.5}
    StatModifier: 10
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 5b31dc55-a9ff-4fd5-b6eb-a105fe32cd43
    DialogueText: "Je le voyais perdre au poker par la fen\xEAtre depuis la rue quand
      je jouais avec mes copains."
    Position: {x: 6449.5, y: -14}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 89dc25a3-bb39-4c66-9e52-270aad7e3ccf
    DialogueText: "J'aurais bien aim\xE9 faire une partie avec lui, j'suis s\xFBr
      que je l'aurais plum\xE9."
    Position: {x: 7219, y: -12.5}
    StatModifier: 0
    Ports: []
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: b0fb13ce-398a-45d3-9f5b-57accccfe80f
    DialogueText: "J'vais m'installer, merci pour les bi\xE8res l'ami."
    Position: {x: 6350, y: -231}
    StatModifier: 0
    Ports: []
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 5594627e-4377-4422-b66c-774ca718b9d8
    DialogueText: "Bonne journ\xE9e, j'boirais pour toi aussi, haha."
    Position: {x: 4340.5, y: 75}
    StatModifier: 0
    Ports: []
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 48df3361-4fc2-4878-9715-0ca7228d100e
    DialogueText: Enfin, on va pas cracher sur les morts.
    Position: {x: 5802.5, y: -231}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
