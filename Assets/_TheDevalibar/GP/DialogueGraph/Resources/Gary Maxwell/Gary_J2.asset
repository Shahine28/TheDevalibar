  - NodeGUID: 6811b738-fc27-4230-bbe4-ac3928ba6e90
    DialogueText: "Il tabassait un de mes amis quand je l'ai attrapp\xE9. Il y \xE0
      laiss\xE9 des plumes."
    Position: {x: 6512.5, y: 169}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
