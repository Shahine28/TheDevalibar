  - NodeGUID: 0c156583-e5f6-446f-8328-82716a3d877f
    DialogueText: "Pas juste comme \xE7a, pour \xEAtre honn\xEAte y'\xE0 un poulet
      que j'ai pas mal amoch\xE9."
    Position: {x: 5745.5, y: 169}
    StatModifier: 0
