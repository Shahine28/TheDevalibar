      Direction: 1
      Capacity: 0
      IsPortNull: 0
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 2a814aa4-e94c-4f24-8539-011313847ccb
    DialogueText: "Pffff tu parles, c'est des serviettes, on les a essor\xE9s oui.
