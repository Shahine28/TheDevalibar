    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: d835d87b-c0f1-4111-b4fb-602af462fc09
    DialogueText: "Mais heureusement, Genevi\xE8ve m'a aid\xE9 avec les questions
      l\xE9gales, t'aurais d\xFB la voir engueuler les gars de l'administration,
      c'\xE9tait du grand spectacle haha !"
    Position: {x: 9751, y: 908}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: d47c1ca4-51f3-409f-9ce6-55b2f89d0eda
    DialogueText: "Mais bon ils ont r\xE9ussi \xE0 m'imposer des agents de probations
      r\xE9guliers, et le dernier me l\xE2che pas."
    Position: {x: 10879.5, y: 909}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 569bd412-41ac-49cf-bdb8-1f75ca122285
    DialogueText: "Je sais pas ce qu'il \xE0 contre moi, mais il fait tout pour me
      plomber."
    Position: {x: 11690, y: 909}
    StatModifier: 0
    Ports:
    - PortName: "J'esp\xE8re que \xE7a va se calmer alors."
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    - PortName: Tiens le premier verre est pour moi alors, bon courage
      Direction: 1
      Capacity: 0
      IsPortNull: 0
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 21300000, guid: 4dc75e3b4c268422991fe5eb2e1a5a51, type: 3}
  - NodeGUID: 0a5f3d30-d626-4cff-aabf-0aa410742507
