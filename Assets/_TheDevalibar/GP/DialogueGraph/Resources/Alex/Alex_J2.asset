  DialogueNodeData:
  - NodeGUID: 0643145e-5eca-4d8c-9a82-8c13d9218071
    DialogueText: "On dirait le Camdem de l'\xE9poque des anciens."
    Position: {x: 782, y: 173}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
