    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 0}
  - NodeGUID: eb564f69-1267-44b4-8be6-ad91badedffe
    DialogueText: " Ce serait dommage qu'elle se retrouve dans tes pattes pendant
