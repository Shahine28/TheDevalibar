    Ports:
    - PortName: Null Port
      Direction: 1
      Capacity: 0
      IsPortNull: 1
    TriggersEvent: 0
    CharacterMoodSprite: {fileID: 0}
  - NodeGUID: f0ca15de-6a69-457f-840c-722dc22e3228
    DialogueText: "Malheureusement, ils ont \xE9t\xE9 r\xE9prim\xE9s violemment,
