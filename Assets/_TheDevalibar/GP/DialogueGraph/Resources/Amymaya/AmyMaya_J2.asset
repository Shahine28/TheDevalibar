  DialogueNodeData:
  - NodeGUID: 3cfeb682-a349-45e9-878c-bbd10179b560
    DialogueText: Saluuuuut Madame baaaaaaar !
    Position: {x: 287.5, y: 200}
    StatModifier: 0
    Ports:
    - PortName: Null Port
      Direction: 1
